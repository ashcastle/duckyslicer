+JNIEXPORT jboolean JNICALL
+Java_com_u1_slicer_NativeLibrary_nativeSetLayerPauses(
+        JNIEnv* env, jobject, jfloatArray jprint_z_values, jobjectArray jmessages) {
+    if (!g_engine || !jprint_z_values || !jmessages) return JNI_FALSE;
+    const jsize count = env->GetArrayLength(jprint_z_values);
+    if (count < 0 || count > 256 || env->GetArrayLength(jmessages) != count) return JNI_FALSE;
+
+    std::vector<jfloat> print_z_values(static_cast<size_t>(count));
+    if (count > 0) env->GetFloatArrayRegion(jprint_z_values, 0, count, print_z_values.data());
+    if (env->ExceptionCheck()) return JNI_FALSE;
+
+    std::vector<std::pair<float, std::string>> pauses;
+    pauses.reserve(static_cast<size_t>(count));
+    for (jsize index = 0; index < count; ++index) {
+        auto* value = static_cast<jstring>(env->GetObjectArrayElement(jmessages, index));
+        if (!value || env->ExceptionCheck()) {
+            if (value) env->DeleteLocalRef(value);
+            return JNI_FALSE;
+        }
+        const char* message = env->GetStringUTFChars(value, nullptr);
+        if (!message || env->ExceptionCheck()) {
+            env->DeleteLocalRef(value);
+            return JNI_FALSE;
+        }
+        pauses.emplace_back(print_z_values[static_cast<size_t>(index)], message);
+        env->ReleaseStringUTFChars(value, message);
+        env->DeleteLocalRef(value);
+    }
+    return g_engine->setLayerPauses(pauses) ? JNI_TRUE : JNI_FALSE;
+}
+
 } // extern "C"
