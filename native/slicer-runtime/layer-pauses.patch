+bool SlicerEngine::setLayerEvents(
+        const std::vector<std::pair<float, std::string>>& pauses,
+        const std::vector<std::pair<float, int>>& filament_changes,
+        const std::vector<std::tuple<float, int, std::string>>& custom_gcodes) {
+    if (!g_model_loaded || pauses.size() > 256 || filament_changes.size() > 256 ||
+        custom_gcodes.size() > 64)
+        return false;
+
+    Slic3r::CustomGCode::Info info;
+    info.mode = filament_changes.empty() ?
+        Slic3r::CustomGCode::SingleExtruder : Slic3r::CustomGCode::MultiAsSingle;
+    info.gcodes.reserve(pauses.size() + filament_changes.size() + custom_gcodes.size());
+    float previous_z = 0.0f;
+    for (const auto& pause : pauses) {
+        const float print_z = pause.first;
+        if (!std::isfinite(print_z) || print_z < 0.001f || print_z > 10000.0f ||
+            print_z <= previous_z || pause.second.size() > 480) {
+            return false;
+        }
+        if (std::any_of(pause.second.begin(), pause.second.end(), [](unsigned char value) {
+                return value < 0x20 || value == 0x7f;
+            })) {
+            return false;
+        }
+        info.gcodes.emplace_back(Slic3r::CustomGCode::Item{
+            static_cast<double>(print_z),
+            Slic3r::CustomGCode::PausePrint,
+            1,
+            "",
+            pause.second,
+        });
+        previous_z = print_z;
+    }
+    previous_z = 0.0f;
+    for (const auto& change : filament_changes) {
+        const float print_z = change.first;
+        if (!std::isfinite(print_z) || print_z < 0.001f || print_z > 10000.0f ||
+            print_z <= previous_z || change.second < 1 || change.second > 16) {
+            return false;
+        }
+        info.gcodes.emplace_back(Slic3r::CustomGCode::Item{
+            static_cast<double>(print_z),
+            Slic3r::CustomGCode::ToolChange,
+            change.second,
+            "",
+            "",
+        });
+        previous_z = print_z;
+    }
+    previous_z = 0.0f;
+    size_t total_custom_gcode_bytes = 0;
+    for (const auto& custom_gcode : custom_gcodes) {
+        const float print_z = std::get<0>(custom_gcode);
+        const int event_type = std::get<1>(custom_gcode);
+        const std::string& code = std::get<2>(custom_gcode);
+        total_custom_gcode_bytes += code.size();
+        if (!std::isfinite(print_z) || print_z < 0.001f || print_z > 10000.0f ||
+            print_z <= previous_z || (event_type != 0 && event_type != 1) ||
+            (event_type == 0 && code.empty()) || (event_type == 1 && !code.empty()) ||
+            code.size() > 2048 ||
+            total_custom_gcode_bytes > 32768 ||
+            std::any_of(pauses.begin(), pauses.end(), [print_z](const auto& pause) {
+                return pause.first == print_z;
+            })) {
+            return false;
+        }
+        size_t line_count = 1;
+        size_t line_bytes = 0;
+        for (unsigned char value : code) {
+            if (value == '\r' || value == 0 || (value < 0x20 && value != '\n' && value != '\t'))
+                return false;
+            if (value == '\n') {
+                if (++line_count > 32 || line_bytes > 256) return false;
+                line_bytes = 0;
+            } else if (++line_bytes > 256) {
+                return false;
+            }
+        }
+        const auto type = event_type == 0 ?
+            Slic3r::CustomGCode::Custom : Slic3r::CustomGCode::Template;
+        info.gcodes.emplace_back(Slic3r::CustomGCode::Item{
+            static_cast<double>(print_z),
+            type,
+            0,
+            "",
+            code,
+        });
+        previous_z = print_z;
+    }
+    std::stable_sort(info.gcodes.begin(), info.gcodes.end());
+    g_model.plates_custom_gcodes[g_model.curr_plate_index] = std::move(info);
+    return true;
+}
