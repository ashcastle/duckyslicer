+JNIEXPORT jboolean JNICALL
+Java_com_u1_slicer_NativeLibrary_nativeSetLayerEvents(
+        JNIEnv* env, jobject, jfloatArray jpause_z_values, jobjectArray jmessages,
+        jfloatArray jchange_z_values, jintArray jchange_extruders) {
+    if (!g_engine || !jpause_z_values || !jmessages ||
+        !jchange_z_values || !jchange_extruders) return JNI_FALSE;
+    const jsize pause_count = env->GetArrayLength(jpause_z_values);
+    const jsize change_count = env->GetArrayLength(jchange_z_values);
+    if (pause_count < 0 || pause_count > 256 ||
+        env->GetArrayLength(jmessages) != pause_count ||
+        change_count < 0 || change_count > 256 ||
+        env->GetArrayLength(jchange_extruders) != change_count) return JNI_FALSE;
+
+    std::vector<jfloat> pause_z_values(static_cast<size_t>(pause_count));
+    if (pause_count > 0)
+        env->GetFloatArrayRegion(jpause_z_values, 0, pause_count, pause_z_values.data());
+    if (env->ExceptionCheck()) return JNI_FALSE;
+
+    std::vector<std::pair<float, std::string>> pauses;
+    pauses.reserve(static_cast<size_t>(pause_count));
+    for (jsize index = 0; index < pause_count; ++index) {
+        auto* value = static_cast<jstring>(env->GetObjectArrayElement(jmessages, index));
+        if (!value || env->ExceptionCheck()) {
+            if (value) env->DeleteLocalRef(value);
+            return JNI_FALSE;
+        }
+        const char* message = env->GetStringUTFChars(value, nullptr);
+        if (!message || env->ExceptionCheck()) {
+            env->DeleteLocalRef(value);
+            return JNI_FALSE;
+        }
+        pauses.emplace_back(pause_z_values[static_cast<size_t>(index)], message);
+        env->ReleaseStringUTFChars(value, message);
+        env->DeleteLocalRef(value);
+    }
+
+    std::vector<jfloat> change_z_values(static_cast<size_t>(change_count));
+    std::vector<jint> change_extruders(static_cast<size_t>(change_count));
+    if (change_count > 0) {
+        env->GetFloatArrayRegion(
+            jchange_z_values, 0, change_count, change_z_values.data());
+        env->GetIntArrayRegion(
+            jchange_extruders, 0, change_count, change_extruders.data());
+    }
+    if (env->ExceptionCheck()) return JNI_FALSE;
+    std::vector<std::pair<float, int>> filament_changes;
+    filament_changes.reserve(static_cast<size_t>(change_count));
+    for (jsize index = 0; index < change_count; ++index) {
+        filament_changes.emplace_back(
+            change_z_values[static_cast<size_t>(index)],
+            change_extruders[static_cast<size_t>(index)]);
+    }
+    return g_engine->setLayerEvents(pauses, filament_changes) ? JNI_TRUE : JNI_FALSE;
+}
+
 } // extern "C"
