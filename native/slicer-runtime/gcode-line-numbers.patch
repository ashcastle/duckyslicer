+static void addGcodeLineNumbers(const std::string& output_path) {
+    const std::string temporary_path = output_path + ".line-numbers.tmp";
+    std::remove(temporary_path.c_str());
+    struct TemporaryFileGuard {
+        const std::string& path;
+        bool committed = false;
+        ~TemporaryFileGuard() {
+            if (!committed) std::remove(path.c_str());
+        }
+    } temporary_guard{temporary_path};
+
+    std::ifstream input(output_path, std::ios::binary);
+    std::ofstream output(temporary_path, std::ios::binary | std::ios::trunc);
+    if (!input || !output) {
+        throw std::runtime_error("Could not open G-code line-number stream");
+    }
+
+    std::string line;
+    std::uint64_t line_number = 1;
+    while (std::getline(input, line)) {
+        output << 'N' << line_number++ << ' ' << line << '\n';
+        if (!output) {
+            throw std::runtime_error("Could not write G-code line numbers");
+        }
+    }
+    if (!input.eof()) {
+        throw std::runtime_error("Could not read G-code for line numbering");
+    }
+    output.close();
+    if (!output) {
+        throw std::runtime_error("Could not finish G-code line numbering");
+    }
+    input.close();
+    if (std::rename(temporary_path.c_str(), output_path.c_str()) != 0) {
+        throw std::runtime_error("Could not replace G-code with numbered output");
+    }
+    temporary_guard.committed = true;
+}
