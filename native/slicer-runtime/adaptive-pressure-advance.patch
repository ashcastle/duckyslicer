+static void validateAdaptivePressureAdvanceModel(const std::string& value) {
+    if (value.empty() || value.size() > 16384) {
+        throw std::invalid_argument("Invalid adaptive pressure-advance model size");
+    }
+    std::stringstream stream(value);
+    std::string line;
+    std::map<double, std::pair<int, double>> flow_by_acceleration;
+    int point_count = 0;
+    while (std::getline(stream, line)) {
+        const auto first = line.find_first_not_of(" \t\r");
+        const auto last = line.find_last_not_of(" \t\r");
+        if (first == std::string::npos) continue;
+        if (++point_count > 256) {
+            throw std::invalid_argument("Too many adaptive pressure-advance points");
+        }
+        const std::string trimmed = line.substr(first, last - first + 1);
+        std::stringstream point(trimmed);
+        std::string token;
+        double values[3] = {};
+        for (int index = 0; index < 3; ++index) {
+            if (!std::getline(point, token, ',')) {
+                throw std::invalid_argument("Invalid adaptive pressure-advance point");
+            }
+            const auto token_first = token.find_first_not_of(" \t");
+            const auto token_last = token.find_last_not_of(" \t");
+            if (token_first == std::string::npos) {
+                throw std::invalid_argument("Invalid adaptive pressure-advance number");
+            }
+            const std::string number = token.substr(token_first, token_last - token_first + 1);
+            std::size_t parsed = 0;
+            try {
+                values[index] = std::stod(number, &parsed);
+            } catch (const std::exception&) {
+                throw std::invalid_argument("Invalid adaptive pressure-advance number");
+            }
+            if (parsed != number.size() || !std::isfinite(values[index])) {
+                throw std::invalid_argument("Invalid adaptive pressure-advance number");
+            }
+        }
+        if (std::getline(point, token, ',')) {
+            throw std::invalid_argument("Invalid adaptive pressure-advance point");
+        }
+        const double pressure_advance = values[0];
+        const double flow = values[1];
+        const double acceleration = values[2];
+        if (pressure_advance < 0.0 || pressure_advance > 2.0 ||
+            flow < 0.001 || flow > 1000.0 ||
+            acceleration < 1.0 || acceleration > 1000000.0) {
+            throw std::invalid_argument("Unsafe adaptive pressure-advance model");
+        }
+        auto& state = flow_by_acceleration[acceleration];
+        if (state.first > 0 && flow <= state.second) {
+            throw std::invalid_argument("Adaptive pressure-advance flow values must increase");
+        }
+        state = {state.first + 1, flow};
+    }
+    if (point_count < 2 || flow_by_acceleration.empty() ||
+        std::any_of(
+            flow_by_acceleration.begin(),
+            flow_by_acceleration.end(),
+            [](const auto& entry) { return entry.second.first < 2; })) {
+        throw std::invalid_argument("Adaptive pressure-advance model needs two flow points");
+    }
+}
