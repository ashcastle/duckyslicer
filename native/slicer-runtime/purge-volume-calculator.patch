+JNIEXPORT jfloatArray JNICALL
+Java_com_u1_slicer_NativeLibrary_nativeCalculateFlushVolumes(
+        JNIEnv* env, jobject, jintArray jcolors, jfloat jnozzle_volume,
+        jintArray jlong_retractions, jfloatArray jretraction_distances,
+        jintArray jsupport_filaments) {
+    if (!jcolors || !jlong_retractions || !jretraction_distances || !jsupport_filaments ||
+        !std::isfinite(jnozzle_volume) || jnozzle_volume < 0.0f || jnozzle_volume > 1000.0f) {
+        return nullptr;
+    }
+    const jsize count = env->GetArrayLength(jcolors);
+    if (count < 2 || count > 16 ||
+        env->GetArrayLength(jlong_retractions) != count ||
+        env->GetArrayLength(jretraction_distances) != count ||
+        env->GetArrayLength(jsupport_filaments) != count) {
+        return nullptr;
+    }
+
+    std::vector<jint> colors(static_cast<size_t>(count));
+    std::vector<jint> long_retractions(static_cast<size_t>(count));
+    std::vector<jfloat> retraction_distances(static_cast<size_t>(count));
+    std::vector<jint> support_filaments(static_cast<size_t>(count));
+    env->GetIntArrayRegion(jcolors, 0, count, colors.data());
+    env->GetIntArrayRegion(jlong_retractions, 0, count, long_retractions.data());
+    env->GetFloatArrayRegion(jretraction_distances, 0, count, retraction_distances.data());
+    env->GetIntArrayRegion(jsupport_filaments, 0, count, support_filaments.data());
+    if (env->ExceptionCheck()) return nullptr;
+
+    std::vector<float> volumes(static_cast<size_t>(count) * static_cast<size_t>(count), 0.0f);
+    constexpr float filament_area = 3.14159265358979323846f * 1.75f * 1.75f / 4.0f;
+    for (jsize from = 0; from < count; ++from) {
+        if ((colors[from] & ~0x00ffffff) != 0 ||
+            (long_retractions[from] != 0 && long_retractions[from] != 1) ||
+            !std::isfinite(retraction_distances[from]) || retraction_distances[from] < 0.0f ||
+            retraction_distances[from] > 1000.0f ||
+            (support_filaments[from] != 0 && support_filaments[from] != 1)) {
+            return nullptr;
+        }
+        const int retract_length = long_retractions[from] == 1 ?
+            static_cast<int>(retraction_distances[from]) : 0;
+        const int minimum = static_cast<int>(jnozzle_volume) -
+            static_cast<int>(filament_area * static_cast<float>(retract_length));
+        Slic3r::FlushVolCalculator calculator(minimum, Slic3r::g_max_flush_volume);
+        const unsigned int source = static_cast<unsigned int>(colors[from]);
+        for (jsize to = 0; to < count; ++to) {
+            if (from == to) continue;
+            int volume;
+            if (support_filaments[to] == 1) {
+                volume = Slic3r::g_flush_volume_to_support;
+            } else {
+                const unsigned int target = static_cast<unsigned int>(colors[to]);
+                volume = calculator.calc_flush_vol(
+                    255, (source >> 16) & 0xff, (source >> 8) & 0xff, source & 0xff,
+                    255, (target >> 16) & 0xff, (target >> 8) & 0xff, target & 0xff);
+                if (support_filaments[from] == 1)
+                    volume = std::max(volume, Slic3r::g_min_flush_volume_from_support);
+            }
+            volumes[static_cast<size_t>(from) * static_cast<size_t>(count) + static_cast<size_t>(to)] =
+                static_cast<float>(volume);
+        }
+    }
+    jfloatArray result = env->NewFloatArray(static_cast<jsize>(volumes.size()));
+    if (result) env->SetFloatArrayRegion(result, 0, static_cast<jsize>(volumes.size()), volumes.data());
+    return result;
+}
