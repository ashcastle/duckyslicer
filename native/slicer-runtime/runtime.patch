+JNIEXPORT jfloatArray JNICALL
+Java_com_u1_slicer_NativeLibrary_nativeAutoArrangeObjects(
+        JNIEnv* env, jobject, jfloatArray jbed_polygon, jfloat minimum_gap) {
+    if (!g_engine || !jbed_polygon) return nullptr;
+    const jsize length = env->GetArrayLength(jbed_polygon);
+    if (length < 6 || length > 512 || length % 2 != 0) return nullptr;
+    std::vector<float> bed_polygon(static_cast<size_t>(length));
+    env->GetFloatArrayRegion(jbed_polygon, 0, length, bed_polygon.data());
+    if (env->ExceptionCheck()) return nullptr;
+    auto positions = g_engine->autoArrangeObjects(bed_polygon, minimum_gap);
+    if (!positions) return nullptr;
+    jfloatArray result = env->NewFloatArray(static_cast<jsize>(positions->size()));
+    if (!positions->empty()) {
+        env->SetFloatArrayRegion(
+            result, 0, static_cast<jsize>(positions->size()), positions->data());
+    }
+    return result;
+}
