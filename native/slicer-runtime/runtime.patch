 #include <cmath>
 #include "libslic3r/BoundingBox.hpp"
@@ -549,6 +550,54 @@ bool SlicerEngine::setObjectPositions(const std::vector<std::pair<float, float>>
     return true;
 }
 
+std::optional<std::vector<float>> SlicerEngine::autoArrangeObjects(
+    const std::vector<float>& bedPolygon, float minimumGap) {
+    if (!isModelLoaded() || bedPolygon.size() < 6 || bedPolygon.size() > 512 ||
+        bedPolygon.size() % 2 != 0 || !std::isfinite(minimumGap) || minimumGap < 0.0f) {
+        return std::nullopt;
+    }
+    try {
+        Slic3r::arrangement::ArrangeParams params{Slic3r::scaled(minimumGap)};
+        params.allow_rotations = false;
+        params.progressind = [](unsigned, std::string) {};
+        params.stopcondition = []() { return false; };
+        Slic3r::Points bedPoints;
+        bedPoints.reserve(bedPolygon.size() / 2);
+        for (size_t index = 0; index < bedPolygon.size(); index += 2) {
+            if (!std::isfinite(bedPolygon[index]) || !std::isfinite(bedPolygon[index + 1])) {
+                return std::nullopt;
+            }
+            bedPoints.emplace_back(
+                Slic3r::scaled(bedPolygon[index]),
+                Slic3r::scaled(bedPolygon[index + 1]));
+        }
+        Slic3r::Polygon bed(std::move(bedPoints));
+        if (!bed.is_valid()) return std::nullopt;
+        bed.make_counter_clockwise();
+        Slic3r::ModelInstancePtrs instances;
+        auto polygons = Slic3r::get_arrange_polys(getGlobalModel(), instances);
+        const coord_t inflation = Slic3r::scaled(minimumGap) / 2;
+        for (auto& polygon : polygons) {
+            // This Orca fork uses -1 for both UNARRANGED and libnest2d UNFIT.
+            // Desktop callers seed the selected physical plate before packing.
+            polygon.bed_idx = 0;
+            polygon.inflation = inflation;
+        }
+        Slic3r::arrangement::arrange(polygons, bed, params);
+        if (!Slic3r::apply_arrange_polys(polygons, instances, nullptr)) {
+            return std::nullopt;
+        }
+    } catch (...) {
+        SAPIL_LOGE("autoArrangeObjects: Orca arrangement failed");
+        return std::nullopt;
+    }
+    for (auto* object : getGlobalModel().objects) {
+        object->invalidate_bounding_box();
+    }
+    invalidatePreviewMeshCache();
+    return getObjectWorldAABBMins();
+}
+
