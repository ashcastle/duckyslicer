+    const int new_vol_count = replacements.empty() ? 0 :
+        static_cast<int>(replacements.front()->volumes.size());
+    onSplitObjectReshape(objIdx, static_cast<int>(replacements.size()), new_vol_count);
+    resetLoadTimeScaleFactors();
+    resetRotationBases();
+    invalidatePreviewMeshCache();
+    SAPIL_LOGI(
+        "cutObject: cut %d at %.3f into %d objects",
+        objIdx,
+        heightRatio,
+        static_cast<int>(replacements.size()));
+    return SplitResult{objIdx, static_cast<int>(replacements.size())};
+}
