+std::optional<SlicerEngine::SplitResult> SlicerEngine::cutObject(
+        int objIdx, float heightRatio, bool placeOnCut) {
+    if (!f66_objIdxValid(objIdx) || !std::isfinite(heightRatio) ||
+        heightRatio <= 0.0f || heightRatio >= 1.0f) {
+        return std::nullopt;
+    }
+    Slic3r::Model& model = getGlobalModel();
+    Slic3r::ModelObject* source = model.objects[objIdx];
+    if (source == nullptr || source->instances.empty()) return std::nullopt;
+
+    const Slic3r::BoundingBoxf3 bounds = source->instance_bounding_box(0);
+    if (!bounds.defined || !std::isfinite(bounds.min.z()) ||
+        !std::isfinite(bounds.max.z()) || bounds.size().z() <= 0.0) {
+        return std::nullopt;
+    }
+    const double cut_z = bounds.min.z() + bounds.size().z() * heightRatio;
+    Slic3r::Transform3d cut_matrix = Slic3r::Transform3d::Identity();
+    cut_matrix.translation() = Slic3r::Vec3d(0.0, 0.0, cut_z);
+    const Slic3r::ModelObjectCutAttributes attributes = placeOnCut ?
+        Slic3r::ModelObjectCutAttribute::KeepUpper |
+            Slic3r::ModelObjectCutAttribute::KeepLower |
+            Slic3r::ModelObjectCutAttribute::InvalidateCutInfo |
+            Slic3r::ModelObjectCutAttribute::PlaceOnCutUpper |
+            Slic3r::ModelObjectCutAttribute::PlaceOnCutLower :
+        Slic3r::ModelObjectCutAttribute::KeepUpper |
+            Slic3r::ModelObjectCutAttribute::KeepLower |
+            Slic3r::ModelObjectCutAttribute::InvalidateCutInfo;
+
+    Slic3r::Cut cut(source, 0, cut_matrix, attributes);
+    const Slic3r::ModelObjectPtrs& parts = cut.perform_with_plane();
+    if (parts.size() != 2 || parts[0] == nullptr || parts[1] == nullptr ||
+        parts[0]->volumes.empty() || parts[1]->volumes.empty()) {
+        return std::nullopt;
+    }
+
+    const size_t before_size = model.objects.size();
+    std::vector<Slic3r::ModelObject*> replacements;
+    replacements.reserve(parts.size());
+    for (const Slic3r::ModelObject* part : parts) {
+        Slic3r::ModelObject* replacement = model.add_object(*part);
+        if (replacement == nullptr) {
+            while (model.objects.size() > before_size) {
+                model.delete_object(model.objects.size() - 1);
+            }
+            return std::nullopt;
+        }
+        replacements.push_back(replacement);
+    }
+    model.objects.erase(model.objects.begin() + before_size, model.objects.end());
+    model.delete_object(static_cast<size_t>(objIdx));
+    model.objects.insert(
+        model.objects.begin() + objIdx,
+        replacements.begin(),
+        replacements.end());
+
+    const int new_vol_count = replacements.empty() ? 0 :
+        static_cast<int>(replacements.front()->volumes.size());
+    onSplitObjectReshape(objIdx, static_cast<int>(replacements.size()), new_vol_count);
+    resetLoadTimeScaleFactors();
+    resetRotationBases();
+    invalidatePreviewMeshCache();
+    SAPIL_LOGI(
+        "cutObject: cut %d at %.3f into %d objects",
+        objIdx,
+        heightRatio,
+        static_cast<int>(replacements.size()));
+    return SplitResult{objIdx, static_cast<int>(replacements.size())};
+}
