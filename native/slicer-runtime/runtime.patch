+#include <jni.h>
+
+#include <array>
+#include <cstdint>
+#include <fstream>
+#include <string>
+
+#include "libslic3r/Model.hpp"
+#include "libslic3r/TriangleSelector.hpp"
+
+namespace sapil {
+extern Slic3r::Model g_model;
+}
+
+namespace {
+
+constexpr std::array<unsigned char, 4> MAGIC{'D', 'M', 'C', '1'};
+constexpr std::uint32_t MAX_PAINTED_FACETS = 100000;
+constexpr std::uint32_t MAX_FILAMENT_SLOTS = 16;
+constexpr std::uint64_t HEADER_BYTES = 8;
+constexpr std::uint64_t ENTRY_BYTES = 5;
+
+bool read_u32_be(std::istream& input, std::uint32_t& value)
+{
+    std::array<unsigned char, 4> bytes{};
+    if (!input.read(reinterpret_cast<char*>(bytes.data()), bytes.size())) return false;
+    value = (static_cast<std::uint32_t>(bytes[0]) << 24) |
+            (static_cast<std::uint32_t>(bytes[1]) << 16) |
+            (static_cast<std::uint32_t>(bytes[2]) << 8) |
+            static_cast<std::uint32_t>(bytes[3]);
+    return true;
+}
+
+bool apply_multi_color_paint(int object_index, int volume_index, const std::string& sidecar_path)
+{
+    if (object_index < 0 || static_cast<std::size_t>(object_index) >= sapil::g_model.objects.size()) {
+        return false;
+    }
+    Slic3r::ModelObject* object = sapil::g_model.objects[static_cast<std::size_t>(object_index)];
+    if (object == nullptr) return false;
+    if (volume_index < 0 || static_cast<std::size_t>(volume_index) >= object->volumes.size()) {
+        return false;
+    }
+    Slic3r::ModelVolume* volume = object->volumes[static_cast<std::size_t>(volume_index)];
+    if (volume == nullptr || !volume->is_model_part()) return false;
+
+    std::ifstream input(sidecar_path, std::ios::binary | std::ios::ate);
+    if (!input) return false;
+    const std::streamoff size = input.tellg();
+    if (size < static_cast<std::streamoff>(HEADER_BYTES)) return false;
+    input.seekg(0, std::ios::beg);
+
+    std::array<unsigned char, 4> magic{};
+    if (!input.read(reinterpret_cast<char*>(magic.data()), magic.size()) || magic != MAGIC) {
+        return false;
+    }
+    std::uint32_t count = 0;
+    if (!read_u32_be(input, count) || count > MAX_PAINTED_FACETS) return false;
+    const std::uint64_t expected_size =
+        HEADER_BYTES + static_cast<std::uint64_t>(count) * ENTRY_BYTES;
+    if (static_cast<std::uint64_t>(size) != expected_size) return false;
+
+    const std::size_t triangle_count = volume->mesh().its.indices.size();
+    Slic3r::TriangleSelector selector(volume->mesh());
+    std::uint32_t previous_index = 0;
+    bool has_previous = false;
+    for (std::uint32_t entry = 0; entry < count; ++entry) {
+        std::uint32_t facet_index = 0;
+        unsigned char state = 0;
+        if (!read_u32_be(input, facet_index) ||
+            !input.read(reinterpret_cast<char*>(&state), 1)) {
+            return false;
+        }
+        if (static_cast<std::size_t>(facet_index) >= triangle_count ||
+            (has_previous && facet_index <= previous_index) ||
+            state == 0 || state > MAX_FILAMENT_SLOTS) {
+            return false;
+        }
+        selector.set_facet(
+            static_cast<int>(facet_index),
+            static_cast<Slic3r::EnforcerBlockerType>(state));
+        previous_index = facet_index;
+        has_previous = true;
+    }
+    const bool changed = volume->mmu_segmentation_facets.set(selector);
+    return changed || count == 0;
+}
