+static bool validExtraSolidInfills(const std::string& value) {
+    std::string candidate;
+    candidate.reserve(value.size());
+    for (const char character : value) {
+        if (character != ' ' && character != '\t' && character != '\n' && character != '\r') {
+            candidate.push_back(character);
+        }
+    }
+    if (candidate.empty()) return true;
+    if (candidate.size() > 256 || candidate.front() == ',' || candidate.back() == ',') return false;
+
+    std::vector<std::string> tokens;
+    std::stringstream stream(candidate);
+    std::string token;
+    while (std::getline(stream, token, ',')) {
+        if (token.empty() || tokens.size() >= 64) return false;
+        tokens.push_back(token);
+    }
+    const bool multiple = tokens.size() > 1;
+    for (const std::string& entry : tokens) {
+        const auto separator = entry.find('#');
+        if (separator != std::string::npos && entry.find('#', separator + 1) != std::string::npos) return false;
+        const std::string base_text = entry.substr(0, separator);
+        const std::string count_text = separator == std::string::npos ? "" : entry.substr(separator + 1);
+        const auto digits = [](const std::string& text) {
+            return !text.empty() && std::all_of(text.begin(), text.end(), [](const unsigned char character) {
+                return character >= '0' && character <= '9';
+            });
+        };
+        if (!digits(base_text) || (!count_text.empty() && !digits(count_text))) return false;
+        try {
+            const unsigned long long base = std::stoull(base_text);
+            const unsigned long long count = count_text.empty() ? 1 : std::stoull(count_text);
+            if (base < 1 || base > 1000000 || count < 1 || count > 10000 || (!multiple && count > base)) {
+                return false;
+            }
+        } catch (const std::exception&) {
+            return false;
+        }
+    }
+    return !tokens.empty();
+}
