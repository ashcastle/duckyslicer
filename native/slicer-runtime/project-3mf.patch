+static bool hasDuckySlicerApplication(const std::string& filepath)
+{
+    mz_zip_archive zip;
+    mz_zip_zero_struct(&zip);
+    if (!mz_zip_reader_init_file(&zip, filepath.c_str(), 0)) return false;
+    bool found = false;
+    const int model_index = locateZipEntry(zip, "3D/3dmodel.model");
+    if (model_index >= 0) {
+        mz_zip_reader_extract_iter_state* iterator =
+            mz_zip_reader_extract_iter_new(&zip, static_cast<mz_uint>(model_index), 0);
+        if (iterator != nullptr) {
+            std::string prefix;
+            prefix.reserve(64 * 1024);
+            char buffer[4096];
+            while (prefix.size() < 64 * 1024) {
+                const std::size_t remaining = 64 * 1024 - prefix.size();
+                const std::size_t count = mz_zip_reader_extract_iter_read(
+                    iterator, buffer, std::min(remaining, sizeof(buffer)));
+                if (count == 0) break;
+                prefix.append(buffer, count);
+                if (prefix.find("<metadata name=\"Application\">DuckySlicer-") != std::string::npos) {
+                    found = true;
+                    break;
+                }
+                if (prefix.find("<resources") != std::string::npos) break;
+            }
+            mz_zip_reader_extract_iter_free(iterator);
+        }
+    }
+    mz_zip_reader_end(&zip);
+    return found;
+}
