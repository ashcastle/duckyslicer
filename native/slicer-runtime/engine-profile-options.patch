+void WipeTower2::update_wall_skip_points(const WipeTowerInfo &layer)
+{
+    m_wall_skip_points.clear();
+    if (!m_use_gap_wall || m_layer_info == m_plan.end())
+        return;
+
+    const size_t layer_index = size_t(m_layer_info - m_plan.begin());
+    float process_depth = 0.f;
+    auto append_points = [&](const std::vector<WipeTowerInfo::ToolChange> &tool_changes) {
+        for (const WipeTowerInfo::ToolChange &tool_change : tool_changes) {
+            const float wipe_depth = std::max(m_perimeter_width, tool_change.required_depth);
+            const float far_y = std::max(process_depth,
+                process_depth + wipe_depth - m_extra_spacing_wipe * m_perimeter_width);
+            Vec2f point;
+            switch (layer_index % 4) {
+            case 0: point = Vec2f(0.f, process_depth); break;
+            case 1: point = Vec2f(m_wipe_tower_width, far_y); break;
+            case 2: point = Vec2f(m_wipe_tower_width, process_depth); break;
+            default: point = Vec2f(0.f, far_y); break;
+            }
+            point.y() = std::max(0.f, std::min(point.y(), layer.depth));
+            m_wall_skip_points.emplace_back(point);
+            process_depth += tool_change.required_depth;
+        }
+    };
+    append_points(layer.local_z_tool_changes);
+    append_points(layer.tool_changes);
+}
